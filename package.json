{
  "name": "@arffornia/nexus_mods",
  "author": "TheGostsniperfr",
  "version": "1.0.12",
  "description": "Minecraft mod and file sync library (CurseForge, Modrinth, GitHub Releases, external file index) used by the Arffornia launcher and config-updater.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arffornia/Nexus_Mods.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "jest",
    "test:live": "jest --config jest.live.config.js --runInBand",
    "typecheck": "tsc --noEmit -p .",
    "build": "tsc && tsc-alias",
    "deploy": "npm run build && npm publish --access public"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.3.3",
    "axios": "1.20.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "tsc-alias": "1.9.9",
    "typescript": "5.9.2"
  },
  "bugs": {
    "url": "https://github.com/Arffornia/Nexus_Mods/issues"
  },
  "homepage": "https://github.com/Arffornia/Nexus_Mods#readme",
  "engines": {
    "node": ">=20"
  }
}
